# Ember Linux — recommended welcome.conf overrides
#
# The branding component already defines productUrl, supportUrl,
# knownIssuesUrl and releaseNotesUrl. Enable the matching buttons so the
# welcome page exposes them. Merge these keys into /etc/calamares/modules/
# welcome.conf; do not replace the whole file blindly.
---
showSupportUrl: true
showKnownIssuesUrl: true
showReleaseNotesUrl: true
showDonateUrl: false
