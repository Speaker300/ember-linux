configuration {
    font: "Inter 11";
    show-icons: true;
    icon-theme: "Ember";
    display-drun: "Applications";
    display-run: "Run a command";
    display-window: "Windows";
    drun-display-format: "{name}";
    case-sensitive: false;
    cycle: true;
    matching: "normal";
    terminal: "xterm";
}

@theme "/usr/share/rofi/themes/ember.rasi"
